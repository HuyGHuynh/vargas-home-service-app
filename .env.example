# Environment Variables for Vargas Home Service App
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/vargas_home_service

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Gmail API Configuration
SENDER_EMAIL=vargashomeservice3@gmail.com
SENDER_NAME=Vargas' Home Services

# Note: 
# 1. Replace SENDER_EMAIL with your actual Gmail address
# 2. Make sure credentials.json is in the project root
# 3. Follow the Google Cloud Console setup instructions